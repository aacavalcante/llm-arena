# Chaves dos provedores (pelo menos uma, ou FAKE_PROVIDERS=true para o modo demo)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Servidor
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# Regras da luta
HP=100
ROUNDS=3
ROUND_SECONDS=90
MAX_ATTEMPTS_PER_CHALLENGE=4
MAX_GOLPES_PER_ROUND=12

# LLM
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_S=60
FIRST_TOKEN_TIMEOUT_S=20

# Sandbox
SANDBOX_WALL_S=3.5
SANDBOX_MEM_MB=256
SANDBOX_NETNS=auto

# Modo demo sem chaves (provedor fake que resolve os desafios com as soluções de referência)
FAKE_PROVIDERS=false

# Juiz do modo "problema personalizado" (padrão: anthropic/claude-opus-5-5, senão openrouter/google/gemini-2.5-pro)
JUDGE_PROVIDER=
JUDGE_MODEL=
